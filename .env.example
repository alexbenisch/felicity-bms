# Felicity BMS Configuration
# Copy this file to .env and fill in your actual values

# Number of batteries (optional, defaults to 1)
NUM_BATTERIES=2

# BMS Device Configuration
BMS_DEVICE=/dev/ttyUSB0
BMS_BAUDRATE=9600
BMS_CLIENT_ID_1=1
BMS_CLIENT_ID_2=2

# MQTT Configuration
MQTT_HOST=your_mqtt_host
MQTT_USER=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password